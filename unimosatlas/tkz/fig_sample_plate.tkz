% TikZ prototype plate: 8 hexadecagons in a row demonstrating 2 full 4-cycle quartets
\begin{tikzpicture}[>=latex, line join=round, line cap=round, scale=0.74]
  \tikzstyle{hexadecagon}=[regular polygon, regular polygon sides=16, minimum size=1.75cm, draw=gray!40, thin]
  % Quartet 1, Step 1 (x = 0.00)
  \begin{scope}[shift={(0.00, 0.00)}]
    \node[hexadecagon] (H0) at (0,0) {};
    \fill[mosaicblue, fill opacity=0.60] (H0.corner 1) -- (H0.corner 2) -- (H0.corner 3) -- (H0.corner 4) -- cycle;
    \draw[black!85, line width=0.45pt] (H0.corner 1) -- (H0.corner 2) -- (H0.corner 3) -- (H0.corner 4) -- cycle;
    \fill[mosaicblue, fill opacity=0.60] (H0.corner 5) -- (H0.corner 6) -- (H0.corner 7) -- (H0.corner 8) -- cycle;
