    \fill[mosaicblue, fill opacity=0.60] (H0.corner 9) -- (H0.corner 10) -- (H0.corner 11) -- (H0.corner 12) -- cycle;
    \draw[black!85, line width=0.45pt] (H0.corner 9) -- (H0.corner 10) -- (H0.corner 11) -- (H0.corner 12) -- cycle;
    \fill[mosaicblue, fill opacity=0.60] (H0.corner 13) -- (H0.corner 14) -- (H0.corner 15) -- (H0.corner 16) -- cycle;
    \draw[black!85, line width=0.45pt] (H0.corner 13) -- (H0.corner 14) -- (H0.corner 15) -- (H0.corner 16) -- cycle;
    \node[below=0.92cm of H0.center, inner sep=0.5pt] {\scriptsize $O^{(1)}$};
  \end{scope}
